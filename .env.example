# Copy to .env and fill locally. Never commit the real key.
DJANGO_ENV=development
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Required. Use a DIFFERENT secret on the VPS. Never share it in chat or Git.
DJANGO_SECRET_KEY=
# Optional development LAN hosts must be listed explicitly, without http://.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],10.0.2.2
# Production: DJANGO_ENV=production
# DJANGO_ALLOWED_HOSTS=dacar-market.kz,www.dacar-market.kz
# Only when needed for genuine cross-origin forms (no wildcards):
# DJANGO_CSRF_TRUSTED_ORIGINS=https://dacar-market.kz,https://www.dacar-market.kz
# Behind Nginx ONLY if it overwrites forwarded headers:
# DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional server-monitor alerts. Never commit real values.
TELEGRAM_ALERTS_ENABLED=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
